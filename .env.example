# SmartATS Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/smartats

# Authentication Secret
JWT_SECRET=super_secret_jwt_key_smartats_production_2026_change_in_production
JWT_EXPIRES_IN=7d

# AI API Key (Optional - Provider-independent OpenAI-compatible API)
# If left empty or undefined, SmartATS uses its high-accuracy deterministic heuristic NLP engine
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
